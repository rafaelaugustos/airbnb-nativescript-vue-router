{
  "name": "airbnb-nativescript-vue-router",
  "version": "0.1.0",
  "private": true,
  "main": "src/app.ts",
  "description": "Airbnb-inspired NativeScript-Vue app using vue-router-ns.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelaugustos/airbnb-nativescript-vue-router.git"
  },
  "scripts": {
    "ios": "ns run ios",
    "android": "ns run android",
    "build:ios": "ns build ios --emulator",
    "build:android": "ns build android",
    "bundle:ios": "webpack --env ios",
    "bundle:android": "webpack --env android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nativescript/core": "9.1.3",
    "nativescript-vue": "3.1.2",
    "vue-router-ns": "0.1.0-rc.2"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/ios": "9.1.0",
    "@nativescript/types": "~9.1.1",
    "@nativescript/webpack": "~5.0.38",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
